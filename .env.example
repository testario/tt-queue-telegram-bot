# Telegram: используйте отдельного тестового бота и тестовый чат для dev-стенда.
TG_BOT_API_TOKEN=replace_with_dev_bot_token
TG_CHAT_ID=-1001234567890

# Прокси для доступа к api.telegram.org, если сервер находится в РФ (Telegram
# заблокирован на уровне сети). В Docker-стенде (docker-compose.yml /
# docker-compose.vps-dev.yml) значение уже прописано на сервисы bot/backend
# как http://xray:1080 (см. xray/README.md) и эта переменная не нужна.
# Задавайте её здесь только при запуске bot/backend вне Docker (PM2, systemd
# и т.п.) — тогда это адрес локального прокси-процесса на хосте, например:
# http://127.0.0.1:1080
#HTTP_PROXY=

# Публичный адрес dev Mini App. Регистрация кнопки выполняется отдельно в @BotFather.
WEBAPP_URL=https://tt-bot.dev.liffesteel.ru

# Dev-стенд публичный, поэтому Telegram-авторизация должна остаться включённой.
NODE_ENV=production

# Локализация бота
BOT_LOCALE=ru
BOT_FALLBACK_LOCALE=en

# Общее хранилище игроков для backend и bot-процессов.
# Обязательно для production/all-in-one deployment. В development/test можно
# не задавать URI: приложение использует InMemory fallback.
PLAYERS_MONGODB_URI=mongodb://mongodb:27017
PLAYERS_MONGODB_DB=tt-queue-bot
PLAYERS_MONGODB_COLLECTION=players

# Тестовые возможности должны быть выключены на публичном dev-стенде.
ENABLE_TEST_FEATURE=false
