{
  "name": "tt-queue-bot",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "nodemon src/index",
    "start:metrics": "nodemon --exec \"node src/index.js --metrics\"",
    "start:bot": "node src/index-bot.js",
    "start:backend": "node src/index-backend.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "build:webapp": "cd mini-app && npm run build",
    "deploy": "npm run build:webapp && pm2 restart tt-queue-bot"
  },
  "author": "",
  "license": "ISC",
  "imports": {
    "#application": "./src/application/index.js",
    "#application/*": "./src/application/*",
    "#domain": "./src/domain/index.js",
    "#domain/*": "./src/domain/*",
    "#infrastructure": "./src/infrastructure/index.js",
    "#infrastructure/*": "./src/infrastructure/*",
    "#interfaces": "./src/interfaces/index.js",
    "#interfaces/*": "./src/interfaces/*"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^8.3.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.8.5",
    "ioredis": "^5.0.0",
    "mongodb": "^6.21.0",
    "node-telegram-bot-api": "^0.67.0"
  },
  "devDependencies": {
    "@jest/test-sequencer": "^29.7.0",
    "ioredis-mock": "^8.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9"
  }
}
