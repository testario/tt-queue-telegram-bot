{
  "name": "tt-queue-bot",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "NODE_USE_ENV_PROXY=1 nodemon src/index",
    "start:metrics": "NODE_USE_ENV_PROXY=1 nodemon --exec \"node src/index.js --metrics\"",
    "start:bot": "NODE_USE_ENV_PROXY=1 node src/index-bot.js",
    "start:backend": "NODE_USE_ENV_PROXY=1 node src/index-backend.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "build:webapp": "cd mini-app && npm run build",
    "deploy": "npm run build:webapp && pm2 restart tt-queue-bot"
  },
  "author": "",
  "license": "ISC",
  "imports": {
    "#application": "./src/application/index.js",
    "#application/*": "./src/application/*",
    "#domain": "./src/domain/index.js",
    "#domain/*": "./src/domain/*",
    "#infrastructure": "./src/infrastructure/index.js",
    "#infrastructure/*": "./src/infrastructure/*",
    "#interfaces": "./src/interfaces/index.js",
    "#interfaces/*": "./src/interfaces/*"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "10.1.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "mongodb": "^6.21.0",
    "node-telegram-bot-api": "^2.1.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "ioredis-mock": "^8.0.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14"
  }
}
